# Local development environment template
# Do not put real secrets in this file.
# Copy this file to `.env` only on your local machine and populate values from approved secure sources.

# Environment
ENVIRONMENT=local
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_LOCAL_DESIGN_MODE=false

# Azure Service Principal
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_SCOPE=
AZURE_AD_LOGIN_URL=https://login.microsoftonline.com
AZURE_AD_LOGIN_URL_VERSION=v2.0

# Azure Key Vault
KEY_VAULT_URL=

# Databricks local settings
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_DQ_NOTEBOOK_JOB_ID=
DATABRICKS_DRIFT_NOTEBOOK_JOB_ID=
DATABRICKS_KPI_NOTEBOOK_JOB_ID=
DATABRICKS_HELPER_FUNCTIONS_NOTEBOOK_JOB_ID=
DATABRICKS_CLUSTER_ID=

# Splunk service
SPLUNK_SERVICE_BASE_URL=
SPLUNK_FUNCTION_SECRET=

# Dashboard endpoint data source
# Which source answers POST /api/dashboard/metrics and /api/dashboard/timeseries.
#   splunk (default, also used when unset) — the deployed boundary. The live
#     saved-search, filter, and result-field contracts are still incomplete, so
#     metrics return explicit unavailable states and timeseries returns HTTP 501.
#   mock — local JSON fixtures, for developing the dashboards offline. Every
#     response it returns is marked illustrative.
# This is independent of NEXT_PUBLIC_LOCAL_DESIGN_MODE, which controls the older
# combined main-view routes rather than these endpoints.
DASHBOARD_DATA_SOURCE=mock

# RBAC
# Used only when ENVIRONMENT=local. Set this to dashboard_users.email, dashboard_users.azure_oid,
# or dashboard_users.user_id so local development still performs the real Databricks RBAC check.
RBAC_LOCAL_USER_IDENTIFIER=
RBAC_CACHE_TTL_MS=60000

# Local design mode
# Enable to bypass auth/ACL and use local mock bootstrap responses for page-design workflows.
# Keep this false outside local development.
# NEXT_PUBLIC_LOCAL_DESIGN_MODE=true

# Key Vault secret names expected in non-local environments
# kv-data-integrity-ad-scope
# kv-data-integrity-adb-server-hostname
# kv-data-integrity-adb-http-path
# kv-data-integrity-adb-dq-notebook-job-id
# kv-data-integrity-adb-drift-notebook-job-id
# kv-data-integrity-adb-kpi-notebook-job-id
# kv-data-integrity-adb-functions-notebook-job-id
# kv-data-integrity-adb-cluster-id
# kv-data-integrity-eventhub-namespace
# kv-data-integrity-eventhub-name
# kv-data-integrity-splunk-service-base-url
# kv-data-integrity-splunk-function-secret
